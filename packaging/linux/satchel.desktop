[Desktop Entry]
Type=Application
Name=Satchel
GenericName=File Manager
Comment=Browse and manage files, fast
Exec=satchel %F
TryExec=satchel
Icon=satchel
Terminal=false
StartupNotify=true
StartupWMClass=satchel
Categories=System;FileTools;FileManager;Utility;
Keywords=files;folders;file manager;explorer;finder;
MimeType=inode/directory;
